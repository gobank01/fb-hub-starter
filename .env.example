# คัดลอกไฟล์นี้เป็น ~/fb-hub/.env แล้วเติมค่าของคุณเอง
# ทุกสคริปต์อ่านจากไฟล์นี้ ไม่มีอะไรฝังอยู่ในโค้ด

# ── บัญชี Facebook ที่บอทจะใช้ ────────────────────────────────
# FB_HANDLE = ชื่อในลิงก์โปรไฟล์  facebook.com/<handle>
# FB_NAME   = ชื่อที่ Facebook แสดงบนคอมเมนต์ของคุณ (ต้องตรงเป๊ะ ใช้ตรวจว่าคอมเมนต์ไหนเป็นของเรา)
FB_HANDLE=yourhandle
FB_NAME="Your Display Name"

# OWNER = ชื่อที่ใช้เรียกในข้อความ เช่น "พี่โจ" / "แอดมิน" / "ร้านเรา"
# ไม่ตั้งก็ได้ ระบบจะใช้ FB_NAME แทน
OWNER=""

# ── จังหวะการทำงาน ────────────────────────────────────────────
MAX_PER_ROUND=10          # ตอบได้กี่คนต่อรอบ
MIN_GAP=70                # หน่วงต่ำสุด (วินาที) ห้ามต่ำกว่า 60
MAX_GAP=170               # หน่วงสูงสุด (วินาที)
RECENT_DAYS=7             # ย้อนดูโพสต์กี่วัน

# ── เพดานกันโดนแบน (fb-quota.py เช็กก่อนตอบทุกคน) ────────────
MAX_PER_HOUR=12           # ต่อชั่วโมง (ย้อนหลัง 60 นาที) ระบบต้นแบบใช้ 12 มา 3 เดือนไม่โดนอะไร
MAX_PER_DAY=0             # ต่อวัน 0 = ไม่จำกัด

# ── เสียงของข้อความ (fb-reply-check.py ด่านตรวจก่อนส่ง) ───────
REPLY_PARTICLE=ครับ        # คำลงท้ายของเจ้าของเพจ: ครับ หรือ ค่ะ (อีกแบบจะถูกตีกลับ)
REPLY_MAX_LEN=300         # ยาวสุดกี่ตัวอักษร (คนจริงคอมเมนต์มัธยฐาน ~50 ตัว)

# ── สมองของบอท ────────────────────────────────────────────────
# sonnet พอสำหรับงานนี้ และกินโควตาน้อยกว่า opus มาก (บอทใช้โควตาบัญชี Claude เดียวกับคุณ)
CLAUDE_MODEL=sonnet

# ── แจ้งเตือน — ต้องตั้งอย่างน้อย Telegram ─────────────────────
# ไม่ตั้งเลย = บอทพังแล้วไม่มีใครรู้ (notify.py จะ exit 1 ดัง ๆ)
# ทดสอบ: python3 ~/fb-hub/bin/notify.py --test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ── หน้าเว็บดู log (ไม่ทำก็ได้ ดู log ในเครื่องแทน) ────────────
DASHBOARD_URL=
FB_LOG_SECRET=
