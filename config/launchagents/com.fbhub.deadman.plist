<plist version="1.0"><dict>
  <key>Label</key><string>com.fbhub.deadman</string>
  <key>ProgramArguments</key>
  <array><string>/usr/bin/python3</string><string>$HOME/fb-hub/bin/fb-deadman.py</string></array>
