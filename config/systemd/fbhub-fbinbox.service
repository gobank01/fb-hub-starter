[Unit]
Description=fb-hub: กวาดอินบ็อกซ์
After=network-online.target

[Service]
Type=oneshot
User=__USER__
Environment=DISPLAY=:99
WorkingDirectory=__HOME__
ExecStart=__HOME__/fb-hub/bin/fb-inbox.sh
StandardOutput=append:__HOME__/fb-hub/logs/fbinbox.agent.log
StandardError=append:__HOME__/fb-hub/logs/fbinbox.agent.log
