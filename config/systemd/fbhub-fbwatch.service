[Unit]
Description=fb-hub: กวาดคอมเมนต์ใต้โพสต์แล้วตอบ
After=network-online.target

[Service]
Type=oneshot
User=__USER__
Environment=DISPLAY=:99
WorkingDirectory=__HOME__
ExecStart=__HOME__/fb-hub/bin/fb-watch.sh
StandardOutput=append:__HOME__/fb-hub/logs/fbwatch.agent.log
StandardError=append:__HOME__/fb-hub/logs/fbwatch.agent.log
